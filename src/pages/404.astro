---
import Layout from '../layouts/PresentationLayout.astro';
---
<Layout title="Page not found"><section class="container missing"><p class="eyebrow">404 / Not part of the collection yet</p><h1>This direction is<br />still ahead of us.</h1><p>The page you requested is unavailable. Find the current proposals in the gallery.</p><a class="button" href="/">Back to the gallery ↗</a></section></Layout>
<style>.missing { padding-block:100px; }.missing h1 { font-size:clamp(2.5rem,5vw,4.5rem); margin-block:25px; }.missing .button { margin-top:30px; }</style>
