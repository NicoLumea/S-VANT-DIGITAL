---
import PresentationLayout from '../layouts/PresentationLayout.astro';
import ConceptGallery from '../components/presentation/ConceptGallery.astro';
---
<PresentationLayout title="Website Design Proposals">
  <section class="gallery-hero container">
    <div><p class="eyebrow">Sévant Digital / Website design proposals</p><h1>One identity.<br /><span>Eleven possibilities.</span></h1>
    <p class="hero-intro">Explore creative directions for the future Sévant Digital website. Different perspectives on our identity, our services, and our digital growth philosophy.</p>
    <div class="hero-actions"><a class="button" href="#collection">Explore the collection <span aria-hidden="true">↘</span></a><span>Edition 01 <span aria-hidden="true">—</span> Foundation</span></div></div>
    <div class="exhibition-art" role="img" aria-label="Abstract blue architectural planes representing independent design directions"><span class="art-grid"></span><i></i><i></i><i></i><span class="art-caption">A shared vision.<br />A different point of view.</span><span class="art-number">01 / 11</span></div>
  </section>
  <div class="gallery-strip"><div class="container"><span>WHITE SPACE. CLEAR THINKING.</span><span>INDEPENDENT CONCEPTS</span><span>ONE SHARED IDENTITY</span></div></div>
  <ConceptGallery />
  <section class="review-note container"><span class="eyebrow">A work in progress</span><div><h2>A foundation for the next chapter.</h2><p>Concept 01 is ready for an initial layout review. The remaining directions are planned. Illustrations show design intentions, not completed websites. Approved brand and portfolio materials will complete the presentation.</p></div><a href="/concept-01/" class="button secondary">Review Concept 01 ↗</a></section>
</PresentationLayout>
